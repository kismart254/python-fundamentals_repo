   ],
   "source": [
    "x = \"global\"  # Global variable\n",
    "\n",
    "def my_func():\n",
    "    x = \"local\"  # Local variable inside the function\n",
    "    print(x)\n",
    "\n",
    "my_func()\n",
    "print(x)"
   ]
  }
