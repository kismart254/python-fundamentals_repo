   "source": [
    "import csv\n",
    "\n",
    "# Appending a new row to an existing CSV file\n",
    "new_row = [\"Bob\", \"22\", \"Kisumu\"]\n",
    "\n",
    "with open(\"people.csv\", mode=\"a\", newline=\"\") as file:\n",
    "    writer = csv.writer(file)\n",
    "    writer.writerow(new_row)\n",
    "\n",
    "print(\"New row added successfully!\")"
   ]
  }
