    "import numpy as np\n",
    "\n",
    "arr = np.array([10, 20, 30, 40, 50])\n",
    "\n",
    "# Accessing elements\n",
    "print(\"First element:\", arr[0])\n",
    "\n",
    "# Slicing (from index 1 to 4, stopping before 4)\n",
    "print(\"Sliced array (index 1 to 3):\", arr[1:4])"
   ]
