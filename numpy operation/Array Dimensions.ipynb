    "import numpy as np\n",
    "\n",
    "# 0-D Array (Scalar)\n",
    "arr0 = np.array(42)\n",
    "\n",
    "# 1-D Array\n",
    "arr1 = np.array([1, 2, 3])\n",
    "\n",
    "# 2-D Array (Matrix format with rows and columns)\n",
    "arr2 = np.array([[1, 2, 3], [4, 5, 6]])\n",
    "\n",
    "print(\"2D Array:\\n\", arr2)\n",
    "print(\"Number of dimensions (ndim):\", arr2.ndim)"
   ]
  }
